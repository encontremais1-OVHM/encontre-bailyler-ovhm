# Required: generate a long random secret (32+ bytes). Never commit real secrets.
API_TOKEN=replace-with-a-long-random-secret
PORT=3000
HOST=0.0.0.0
AUTH_DIR=/data/baileys-auth
LOG_LEVEL=info
# Optional comma-separated origins. Leave empty when only server-to-server calls are used.
CORS_ORIGINS=
# Optional webhook destination for connection state notifications.
WEBHOOK_URL=
WEBHOOK_SECRET=
